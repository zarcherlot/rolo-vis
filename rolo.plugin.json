{
  "schema_version": "rolo-plugin/v1",
  "id": "rolo-vis",
  "name": "rolo Workbench",
  "version": "0.37.0",
  "kind": "web-workbench",
  "entry": "dist/client/index.html",
  "capabilities": [
    "fleet.overview.read",
    "fleet.blockers.read",
    "fleet.blockers.detail.read",
    "robot.overview.read",
    "robot.topology.read",
    "robot.topology.diff.read",
    "robot.topology.path.read",
    "robot.capabilities.read",
    "robot.lifecycle.read",
    "robot.wiki.read",
    "robot.discovery.history.read",
    "robot.episode.read",
    "robot.evidence.read"
  ],
  "api": {
    "base_path": "/rolo-api",
    "required_endpoints": [
      "/health",
      "/v1/fleet",
      "/v1/blockers",
      "/v1/robots",
      "/v1/robots/{robot_id}/overview",
      "/v1/robots/{robot_id}/pipeline",
      "/v1/robots/{robot_id}/topology",
      "/v1/robots/{robot_id}/topology/snapshots",
      "/v1/robots/{robot_id}/topology/diff",
      "/v1/robots/{robot_id}/topology/path",
      "/v1/robots/{robot_id}/capabilities",
      "/v1/robots/{robot_id}/capabilities/{operation}",
      "/v1/robots/{robot_id}/runs",
      "/v1/robots/{robot_id}/runs/{run_id}",
      "/v1/robots/{robot_id}/wiki",
      "/v1/robots/{robot_id}/discoveries",
      "/v1/robots/{robot_id}/episodes",
      "/v1/robots/{robot_id}/episodes/{episode_id}",
      "/v1/robots/{robot_id}/episodes/{episode_id}/revisions",
      "/v1/robots/{robot_id}/episodes/{episode_id}/timeline",
      "/v1/robots/{robot_id}/episodes/{episode_id}/observation-bundles",
      "/v1/robots/{robot_id}/episode-cohorts",
      "/v1/robots/{robot_id}/evidence",
      "/v1/evidence/{evidence_id}"
    ]
  },
  "security": {
    "mode": "read-only",
    "remote_access": "loopback-or-trusted-reverse-proxy",
    "allows_arbitrary_commands": false,
    "allows_secret_payloads": false
  }
}
