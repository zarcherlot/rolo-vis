{
  "schema_version": "rolo-plugin/v2",
  "id": "rolo-vis",
  "name": "rolo Workbench",
  "version": "0.37.0",
  "kind": "web-workbench",
  "entry": "dist/client/index.html",
  "delivery": {
    "mode": "device-local",
    "mount_path": "/workbench/",
    "spa_fallback": "scoped"
  },
  "capabilities": [
    "robot.topology.read",
    "robot.capabilities.read",
    "robot.evidence.read"
  ],
  "api": {
    "base_path": "/rolo-api",
    "required_features": [
    "rkb.read-model/v1",
    "mhs.inventory-read-model/v1",
      "tool.verification-read-model/v1",
      "rkb.episodes-read-model/v1",
      "probe.evidence-view/v1",
      "association.report/v1",
      "probe.evidence-request/v1",
      "confirmation.user-intent-receipt/v1"
    ],
    "required_endpoints": [
      "/health", "/v1/fleet", "/v1/blockers", "/v1/robots",
      "/v1/robots/{robot_id}/overview", "/v1/robots/{robot_id}/pipeline",
      "/v1/robots/{robot_id}/topology", "/v1/robots/{robot_id}/topology/snapshots",
      "/v1/robots/{robot_id}/topology/diff", "/v1/robots/{robot_id}/topology/path",
      "/v1/robots/{robot_id}/capabilities", "/v1/robots/{robot_id}/capabilities/{operation}",
      "/v1/robots/{robot_id}/runs", "/v1/robots/{robot_id}/runs/{run_id}",
      "/v1/jobs", "/v1/jobs/{job_id}", "/v1/jobs/{job_id}/events",
      "/v1/targets/readiness", "/v1/targets/{target_id}/readiness", "/v1/approval-gates",
      "/v1/jobs/{job_id}/approval-gate", "/v1/targets/{target_id}/artifact-analysis",
      "/v1/jobs/{job_id}/artifact-analysis", "/v1/robots/{robot_id}/wiki",
      "/v1/robots/{robot_id}/discoveries", "/v1/robots/{robot_id}/episodes",
      "/v1/robots/{robot_id}/episodes/{episode_id}", "/v1/robots/{robot_id}/episodes/{episode_id}/revisions",
      "/v1/robots/{robot_id}/episodes/{episode_id}/timeline",
      "/v1/robots/{robot_id}/episodes/{episode_id}/observation-bundles",
      "/v1/robots/{robot_id}/episode-cohorts", "/v1/robots/{robot_id}/evidence",
      "/v1/evidence/{evidence_id}"
    ],
    "v2_endpoints": [
      "/v1/robots/{robot_id}/rkb", "/v1/robots/{robot_id}/mhs", "/v1/robots/{robot_id}/tools",
      "/v1/robots/{robot_id}/episodes", "/v1/robots/{robot_id}/episodes/{episode_id}",
      "/v1/probe/{robot_id}/evidence-view", "/v1/probe/evidence-requests",
      "/v1/associations/{robot_id}", "/v1/associations/{robot_id}/{association_id}", "/v1/confirmations"
    ]
  },
  "security": {
    "mode": "read-only",
    "remote_access": "loopback-or-trusted-reverse-proxy",
    "allows_arbitrary_commands": false,
    "allows_secret_payloads": false
  },
  "integrity": {
    "algorithm": "sha256",
    "manifest": "SHA256SUMS"
  }
}
